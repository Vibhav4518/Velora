	},
	"item": [
		{
			"name": "1. Admin Login (Get Bearer Token)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"admin@velora.com\",\n  \"password\": \"Admin123!\"\n}"
				},
				"url": {
					"raw": "https://velora-v0f2.onrender.com/api/auth/login/",
					"protocol": "https",
					"host": [
						"velora-v0f2",
						"onrender",
						"com"
					],
					"path": [
						"api",
						"auth",
						"login",
						""
					]
				}
			},
			"response": []
		},
		{
