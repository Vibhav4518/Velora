						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Electronics\",\n  \"slug\": \"electronics\",\n  \"description\": \"Smart devices, audio gear, and personal tech.\"\n}"
				},
				"url": {
					"raw": "https://velora-v0f2.onrender.com/api/categories/",
					"protocol": "https",
					"host": [
						"velora-v0f2",
						"onrender",
						"com"
					],
					"path": [
						"api",
						"categories",
						""
					]
				}
			},
			"response": []
		},
		{
