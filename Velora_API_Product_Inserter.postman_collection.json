			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Velora Signature\",\n  \"slug\": \"velora-signature\",\n  \"description\": \"Flagship luxury design and acoustic precision.\"\n}"
				},
				"url": {
					"raw": "https://velora-v0f2.onrender.com/api/brands/",
					"protocol": "https",
					"host": [
						"velora-v0f2",
						"onrender",
						"com"
					],
					"path": [
						"api",
						"brands",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Create Product (Sample 1 - Headphones)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Velora Wireless ANC Headphones\",\n  \"sku\": \"VEL-ANC-001\",\n  \"category\": 1,\n  \"brand\": 1,\n  \"price\": \"299.99\",\n  \"cost_price\": \"150.00\",\n  \"stock_quantity\": 50,\n  \"description\": \"Active noise cancelling wireless headphones with 40h battery life.\",\n  \"image_url\": \"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80\",\n  \"is_featured\": true,\n  \"is_active\": true\n}"
